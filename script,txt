        if FOVring then FOVring.Radius = val end
    end)
    createSlider("FOV Visibility", 0, 1, fovOpacity, function(val)
        fovOpacity = val
    end)
    createSlider("FOV Thickness", 1, 6, fovThickness, function(val)
        fovThickness = val
        if FOVring then FOVring.Thickness = val end
    end)

    -- Categoria: OPACIDADE
    createCategory("🔆 OPACIDADE")
    createSlider("Box Visibility", 0, 1, boxOpacity, function(val)
        boxOpacity = val
    end)
    createSlider("Tracer Visibility", 0, 1, tracerOpacity, function(val)
        tracerOpacity = val
    end)

    -- Atualiza CanvasSize após criar tudo
    task.wait(0.1)
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y + 10)

    -- ===== FUNCIONALIDADES DE INTERAÇÃO (minimizar, fechar, arrastar) =====
    local menuCollapsed = false
    local menuAnimating = false

    -- Função para minimizar/expandir
    local function setCollapsed(collapsed, instant)
        if menuAnimating and not instant then return end
        menuAnimating = true
        local targetSize = collapsed and UDim2.new(0, 45, 0, 45) or UDim2.new(0, 230, 0, 380)
        local targetPos = collapsed and UDim2.new(0.5, -22, 0, 20) or UDim2.new(0.5, -115, 0.5, -190)

        if collapsed then
            contentFrame.Visible = false
            titleLabel.Text = "JV"
            minimizeBtn.Text = "+"
        else
            contentFrame.Visible = true
            titleLabel.Text = "JV STORE"
            minimizeBtn.Text = "−"
        end

        if instant then
            mainFrame.Size = targetSize
            mainFrame.Position = targetPos
            menuCollapsed = collapsed
            menuAnimating = false
        else
            TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = targetSize,
                Position = targetPos
            }):Play()
            task.wait(0.2)
            menuCollapsed = collapsed
            menuAnimating = false
        end
    end

    minimizeBtn.MouseButton1Click:Connect(function()
        setCollapsed(not menuCollapsed, false)
    end)

    -- Fechar com confirmação (usando a função fullCleanup definida depois)
    local function fullCleanup()
        if mainLoopConn then mainLoopConn:Disconnect(); mainLoopConn = nil end
        if FOVring then FOVring:Remove() end
        for player, data in pairs(espObjects) do
            if data then
                data.box:Remove()
                data.tracer:Remove()
                data.distanceText:Remove()
            end
        end
        espObjects = {}
        menuGui:Destroy()
        notificationGui:Destroy()
        local blur = Lighting:FindFirstChild("JV_LoadingBlur")
        if blur then blur:Destroy() end
    end

    closeBtn.MouseButton1Click:Connect(function()
        local confirmGui = Instance.new("ScreenGui")
        confirmGui.Parent = game:GetService("CoreGui")
        local confirmFrame = Instance.new("Frame")
        confirmFrame.Size = UDim2.new(0, 240, 0, 100)
        confirmFrame.Position = UDim2.new(0.5, -120, 0.5, -50)
        confirmFrame.BackgroundColor3 = Color3.new(0, 0, 0)
        confirmFrame.BackgroundTransparency = 0.05
        confirmFrame.BorderSizePixel = 0
        confirmFrame.Parent = confirmGui
        local confirmCorner = Instance.new("UICorner")
        confirmCorner.CornerRadius = UDim.new(0, 12)
        confirmCorner.Parent = confirmFrame

        local confirmText = Instance.new("TextLabel")
        confirmText.Text = "Deseja realmente finalizar o script?"
        confirmText.Font = Enum.Font.SourceSans
        confirmText.TextSize = 16
        confirmText.TextColor3 = Color3.fromRGB(255, 255, 255)
        confirmText.BackgroundTransparency = 1
        confirmText.Size = UDim2.new(1, 0, 0, 40)
        confirmText.Position = UDim2.new(0, 0, 0, 15)
        confirmText.TextXAlignment = Enum.TextXAlignment.Center
        confirmText.Parent = confirmFrame

        local yesBtn = Instance.new("TextButton")
        yesBtn.Text = "Confirmar"
        yesBtn.Font = Enum.Font.SourceSansBold
        yesBtn.TextSize = 16
        yesBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        yesBtn.BackgroundTransparency = 1
        yesBtn.Size = UDim2.new(0, 80, 0, 30)
        yesBtn.Position = UDim2.new(0, 30, 0, 60)
        yesBtn.Parent = confirmFrame

        local noBtn = Instance.new("TextButton")
        noBtn.Text = "Cancelar"
        noBtn.Font = Enum.Font.SourceSansBold
        noBtn.TextSize = 16
        noBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        noBtn.BackgroundTransparency = 1
        noBtn.Size = UDim2.new(0, 80, 0, 30)
        noBtn.Position = UDim2.new(0, 130, 0, 60)
        noBtn.Parent = confirmFrame

        local function closeConfirm(result)
            confirmGui:Destroy()
            if result then fullCleanup() end
        end
        yesBtn.MouseButton1Click:Connect(function() closeConfirm(true) end)
        noBtn.MouseButton1Click:Connect(function() closeConfirm(false) end)
        yesBtn.Activated:Connect(function() closeConfirm(true) end)
        noBtn.Activated:Connect(function() closeConfirm(false) end)
    end)

    -- Arraste (apenas no header)
    local dragging = false
    local dragStart = nil
    local startPos = nil

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                          startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Animação de entrada do menu
    mainFrame.Scale = UDim2.new(0.95, 0, 0.95, 0)
    mainFrame.BackgroundTransparency = 0.2
    TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 0.05
    }):Play()

    loading.setProgress(0.7, "Preparando sistemas...")

    -- ===== FUNÇÕES DO SCRIPT PRINCIPAL (ESP, AIMBOT, ETC.) =====
    -- (Todas as funções originais são mantidas, apenas referenciadas aqui)

    local function updateDrawings()
        FOVring.Position = Cam.ViewportSize / 2
        FOVring.Radius = fov
        FOVring.Thickness = fovThickness
    end

    local function isPlayerVisible(player)
        local char = player.Character
        if not char then return false end
        local head = char:FindFirstChild("Head")
        if not head then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = { localChar, char }
        local result = Workspace:Raycast(Cam.CFrame.Position, (head.Position - Cam.CFrame.Position), params)
        return result == nil
    end

    local function lookAt(target)
        local lookVector = (target - Cam.CFrame.Position).unit
        Cam.CFrame = CFrame.new(Cam.CFrame.Position, Cam.CFrame.Position + lookVector)
    end

    local function getClosestPlayerInFOV(trg_part)
        local nearest = nil
        local last = math.huge
        local mousePos = Cam.ViewportSize / 2
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer then
                local char = player.Character
                if char then
                    local part = char:FindFirstChild(trg_part)
                    if part then
                        local ePos, isOnScreen = Cam:WorldToViewportPoint(part.Position)
                        local distance = (Vector2.new(ePos.x, ePos.y) - mousePos).Magnitude
                        if isOnScreen and distance < fov and distance < last and isPlayerVisible(player) then
                            last = distance
                            nearest = player
                        end
                    end
                end
            end
        end
        return nearest
    end

    -- ===== ESP =====
    local function createESP(player)
        if espObjects[player] then return end
        local data = {
            box = Drawing.new("Square"),
            tracer = Drawing.new("Line"),
            distanceText = Drawing.new("Text")
        }
        data.box.Visible = false
        data.box.Thickness = 1.5
        data.box.Color = Color3.fromRGB(0, 255, 0)
        data.box.Transparency = 1 - boxOpacity
        data.box.Filled = false

        data.tracer.Visible = false
        data.tracer.Thickness = 1.5
        data.tracer.Color = Color3.fromRGB(255, 255, 255)
        data.tracer.Transparency = 1 - tracerOpacity

        data.distanceText.Visible = false
        data.distanceText.Size = 14
        data.distanceText.Center = true
        data.distanceText.Color = Color3.fromRGB(255, 255, 255)
        data.distanceText.Transparency = 0
        data.distanceText.Font = 0

        espObjects[player] = data
        updateESPColor(player)
    end

    local function updateESPColor(player)
        local data = espObjects[player]
        if not data then return end
        local ally = isAlly(player)
        local color = ally and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        data.box.Color = color
        data.tracer.Color = color
        data.distanceText.Color = color
    end

    local function removeESP(player)
        local data = espObjects[player]
        if data then
            data.box:Remove()
            data.tracer:Remove()
            data.distanceText:Remove()
            espObjects[player] = nil
        end
    end

    -- Atualização periódica de times (a cada 5 segundos)
    task.spawn(function()
        while true do
            task.wait(5)
            for player, data in pairs(espObjects) do
                if player and player.Parent then
                    updateESPColor(player)
                else
                    removeESP(player)
                end
            end
        end
    end)

    local function updateESP()
        if not espAtivo then
            for _, data in pairs(espObjects) do
                data.box.Visible = false
                data.tracer.Visible = false
                data.distanceText.Visible = false
            end
            return
        end

        local viewport = Cam.ViewportSize
        local bottomCenter = Vector2.new(viewport.X / 2, viewport.Y)

        for player, data in pairs(espObjects) do
            local char = player.Character
            if not char or not player.Parent then
                removeESP(player)
                continue
            end

            local head = char:FindFirstChild("Head")
            local torso = char:FindFirstChild("Torso") 
                       or char:FindFirstChild("UpperTorso") 
                       or char:FindFirstChild("LowerTorso") 
                       or char:FindFirstChild("HumanoidRootPart")

            if head and torso then
                local headPos, headVis = Cam:WorldToViewportPoint(head.Position)
                local torsoPos = Cam:WorldToViewportPoint(torso.Position)

                if headVis then
                    local distance = math.floor((Cam.CFrame.Position - head.Position).Magnitude)
                    local height = math.abs(headPos.Y - torsoPos.Y) * 3.5
                    local width = height * 0.5
                    local centerX = headPos.X
                    local centerY = (headPos.Y + torsoPos.Y) / 2

                    data.box.Visible = boxAtivo
                    if boxAtivo then
                        data.box.Size = Vector2.new(width, height)
                        data.box.Position = Vector2.new(centerX - width/2, centerY - height/2)
                        data.box.Transparency = 1 - boxOpacity
                    end

                    data.tracer.Visible = tracerAtivo
                    if tracerAtivo then
                        data.tracer.From = bottomCenter
                        data.tracer.To = Vector2.new(headPos.X, headPos.Y)
                        data.tracer.Transparency = 1 - tracerOpacity
                    end

                    data.distanceText.Visible = distanciaAtivo
                    if distanciaAtivo then
                        data.distanceText.Text = tostring(distance) .. "m"
                        data.distanceText.Position = Vector2.new(headPos.X, headPos.Y + height/2 + 20)
                    end
                else
                    data.box.Visible = false
                    data.tracer.Visible = false
                    data.distanceText.Visible = false
                end
            else
                data.box.Visible = false
                data.tracer.Visible = false
                data.distanceText.Visible = false
            end
        end
    end

    -- ===== CONFIGURAÇÃO DE JOGADORES =====
    local function setupPlayer(player)
        if player == localPlayer then return end
        player.CharacterAdded:Connect(function()
            removeESP(player)
            createESP(player)
        end)
        if player.Character then createESP(player) end
    end

    for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
    Players.PlayerAdded:Connect(setupPlayer)
    Players.PlayerRemoving:Connect(removeESP)
    localPlayer.CharacterAdded:Connect(function(char) localChar = char end)

    menuReady = true
    aimbotReady = true
    espReady = true
    boxReady = true
    tracerReady = true
    distanciaReady = true
    fovReady = true

    -- Finaliza o loading
    loading.setProgress(1, "Pronto!")
    task.wait(0.3)
    loading.finish()

    -- Notificações (mantido)
    task.spawn(function()
        while not antiKickReady do task.wait(0.3) end
        showNotification("🟩 Anti Kick ativado com sucesso.", Color3.fromRGB(0, 255, 0), 3)
        task.wait(3.5)
        showNotification("🟩 Menu JV Store carregado.", Color3.fromRGB(0, 255, 0), 2)
        task.wait(2.5)
        showNotification("🟨 Verificando recursos...", Color3.fromRGB(255, 255, 0), 2)
        task.wait(2.5)
        local allReady = (FOVring and espObjects and mainLoopConn)
        if allReady then
            showNotification("🟩 Verificação concluída.", Color3.fromRGB(0, 255, 0), 2)
            task.wait(2.5)
            showNotification("🟩 Script iniciado com sucesso.", Color3.fromRGB(0, 255, 0), 2)
        else
            showNotification("🟥 Erro na verificação de recursos.", Color3.fromRGB(255, 0, 0), 3)
        end
    end)

    -- Loop principal
    mainLoopConn = RunService.RenderStepped:Connect(function()
        updateDrawings()

        local baseTransparency = 1 - fovOpacity
        if aimbotAtivo then
            local closest = getClosestPlayerInFOV("Head")
            if closest and closest.Character and closest.Character:FindFirstChild("Head") then
                if isPlayerVisible(closest) then
                    lookAt(closest.Character.Head.Position)
                end
                local ePos, isVis = Cam:WorldToViewportPoint(closest.Character.Head.Position)
                if isVis then
                    local dist = (Vector2.new(ePos.x, ePos.y) - Cam.ViewportSize / 2).Magnitude
                    FOVring.Transparency = math.clamp(baseTransparency + (1 - (dist / fov)) * maxTransparency, 0, 1)
                else
                    FOVring.Transparency = baseTransparency
                end
            else
                FOVring.Transparency = baseTransparency
            end
        else
            FOVring.Transparency = baseTransparency
        end

        updateESP()
    end)

    -- Atalho Delete para finalizar
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Delete then
            fullCleanup()
        end
    end)

    -- Redimensionamento da janela (ajuste simples)
    local function onResize()
        -- Ajusta posição se necessário (opcional)
    end
    Cam:GetPropertyChangedSignal("ViewportSize"):Connect(onResize)

end

