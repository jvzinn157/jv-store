local function isMouseOverScrollFrame(mp)
    if scrollFrame.Visible and scrollFrame.AbsolutePosition and scrollFrame.AbsoluteSize then
        local p = scrollFrame.AbsolutePosition
        local s = scrollFrame.AbsoluteSize
        return mp.X >= p.X and mp.X <= p.X + s.X and mp.Y >= p.Y and mp.Y <= p.Y + s.Y
    end
    return false
end

