        thumb.Parent = trackBg
        local thumbCorner = Instance.new("UICorner")
        thumbCorner.CornerRadius = UDim.new(1, 0)
        thumbCorner.Parent = thumb

        local sliderVal = initial

        local function setValue(xFraction)
            local val = min + xFraction * (max - min)
            val = math.clamp(val, min, max)
            sliderVal = val
            label.Text = name .. ": " .. string.format("%.1f", val)
            trackFill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
            thumb.Position = UDim2.new((val - min) / (max - min), -6, 0.5, -6)
            callback(val)
        end

        local dragging = false
        local function updateFromMouse(input)
            local mousePos = input.Position
            local relativeX = mousePos.X - trackBg.AbsolutePosition.X
            local fraction = math.clamp(relativeX / trackBg.AbsoluteSize.X, 0, 1)
            setValue(fraction)
        end

        thumb.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
