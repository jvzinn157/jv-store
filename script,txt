            local hp = resizeHandle.AbsolutePosition
            local hs = resizeHandle.AbsoluteSize
            if mp.X >= hp.X and mp.X <= hp.X + hs.X and mp.Y >= hp.Y and mp.Y <= hp.Y + hs.Y then
                draggingMenu = false
                return
            end
        end
        if isMouseOverScrollFrame(mp) then draggingMenu = false; return end
        for _, area in ipairs(interactiveAreas) do
            if area.Visible and area.AbsolutePosition and area.AbsoluteSize then
                local p = area.AbsolutePosition
                local s = area.AbsoluteSize
                if mp.X >= p.X and mp.X <= p.X + s.X and mp.Y >= p.Y and mp.Y <= p.Y + s.Y then
                    draggingMenu = false
                    return
                end
            end
        end
        if menuCollapsed then return end
        draggingMenu = true
        isDrag = false
        dragStartPos = mp
        dragStartFrame = mainFrame.Position
    end
end

mainFrame.InputBegan:Connect(startDrag)

UserInputService.InputChanged:Connect(function(input)
    if resizing then return end
    if draggingMenu and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        if delta.Magnitude > minDragDistance then isDrag = true end
        if isDrag then
            local newPos = UDim2.new(dragStartFrame.X.Scale, dragStartFrame.X.Offset + delta.X,
                                     dragStartFrame.Y.Scale, dragStartFrame.Y.Offset + delta.Y)
            mainFrame.Position = newPos
            if menuCollapsed then collapsedPos = newPos else expandedPos = newPos end
        end
    end
    if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaY = input.Position.Y - resizeStartY
        local newH = math.clamp(initialHeight + deltaY, minHeight, maxHeight)
        mainFrame.Size = UDim2.new(0, 270, 0, newH)
        expandedSize = mainFrame.Size
        scrollFrame.Size = UDim2.new(1, -16, 0, newH - 52)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if draggingMenu and not isDrag then
            if menuCollapsed then setCollapsed(false, false) end
        end
        draggingMenu = false
        isDrag = false
        resizing = false
    end
end)

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resizeStartY = input.Position.Y
        initialHeight = mainFrame.AbsoluteSize.Y
    end
end)

