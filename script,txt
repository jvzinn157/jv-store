    local value = default
    local function updateState()
        value = not value
        callback(value)
        local targetPos = value and UDim2.new(0, 23, 0, 2) or UDim2.new(0, 2, 0, 2)
        local targetColor = value and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(70, 70, 70)
