-- ===== SISTEMA DE TIME DETECTION (UNIVERSAL) =====
local function getPlayerTeam(player)
    local character = player.Character
    if not character then return nil end
    
    -- 1. Verifica Team padrão do Roblox
    local team = player.Team
    if team then return team.Name end
    
    -- 2. Verifica em acessórios (comum em jogos de time)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") then
            local handle = child:FindFirstChild("Handle")
            if handle and handle:FindFirstChild("BillboardGui") then
                local teamLabel = handle.BillboardGui:FindFirstChild("TeamLabel")
                if teamLabel and teamLabel:IsA("TextLabel") then
                    return teamLabel.Text
                end
            end
        end
    end
    
    -- 3. Verifica em partes do corpo com cores
    local colors = {}
    local parts = {"Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart"}
    for _, partName in ipairs(parts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local color = part.BrickColor
            if color then
                table.insert(colors, color.Name)
            end
        end
    end
    
    -- 4. Verifica padrão de cores
    if #colors > 0 then
        local colorCount = {}
        for _, color in ipairs(colors) do
            colorCount[color] = (colorCount[color] or 0) + 1
        end
        local mostCommon = nil
        local maxCount = 0
        for color, count in pairs(colorCount) do
            if count > maxCount then
                maxCount = count
                mostCommon = color
            end
        end
        if mostCommon then
            local teamColors = {
                ["Bright red"] = "Vermelho",
                ["Really red"] = "Vermelho",
                ["Bright blue"] = "Azul",
                ["Navy blue"] = "Azul",
                ["Bright green"] = "Verde",
                ["Bright yellow"] = "Amarelo"
            }
            return teamColors[mostCommon] or mostCommon
        end
    end
    
    -- 5. Verifica em atributos do jogador
    local attributes = player:GetAttributes()
    for attr, value in pairs(attributes) do
        if string.lower(attr):find("team") or string.lower(attr):find("time") then
            return tostring(value)
        end
    end
    
    return "Espectador"
end

local function isAlly(player)
    if player == LocalPlayer then return true end
    local myTeam = getPlayerTeam(LocalPlayer)
    local theirTeam = getPlayerTeam(player)
    if myTeam and theirTeam and myTeam == theirTeam then
        return true
    end
    return false
end

