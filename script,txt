local function updatePanelSize()
    local screenHeight = Cam.ViewportSize.Y
    local isMobile = UserInputService.TouchEnabled

    local togglesCount = 5
    local slidersCount = 5
    local toggleHeight = 28
    local sliderHeight = 42
    local padding = 8
    local titleHeight = 56
    local topMargin = 8
    local bottomMargin = 12
    -- Cálculo corrigido para incluir a área de informações
    local infoHeight = 18 + 8 * 16 + 7 * 4 + 10
    local contentHeight = (togglesCount * toggleHeight) + (slidersCount * sliderHeight) + ((togglesCount + slidersCount - 1) * padding) + infoHeight
    local totalHeight = titleHeight + contentHeight + topMargin + bottomMargin

    if isMobile then
        local maxMobileHeight = screenHeight * 0.8
        totalHeight = math.min(totalHeight, maxMobileHeight)
    end

    mainFrame.Size = UDim2.new(0, 230, 0, totalHeight)
    scrollFrame.Size = UDim2.new(1, -20, 0, contentHeight)
    scrollFrame.Position = UDim2.new(0, 10, 0, titleHeight + topMargin)
    -- CanvasSize será definido automaticamente via AutomaticCanvasSize
end
