local function createSlider(name, min, max, initial, callback)
    local sf = Instance.new("Frame")
    sf.Size = UDim2.new(1, -16, 0, 36)
    sf.BackgroundTransparency = 1
    sf.Parent = scrollFrame

    local lbl = Instance.new("TextLabel")
    lbl.Text = name .. ": " .. string.format("%.1f", initial)
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 14)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = sf

    local tb = Instance.new("Frame")
    tb.Size = UDim2.new(1, 0, 0, 5)
    tb.Position = UDim2.new(0, 0, 0, 20)
    tb.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    tb.BorderSizePixel = 0
    tb.Parent = sf
    local tbc = Instance.new("UICorner"); tbc.CornerRadius = UDim.new(0, 3); tbc.Parent = tb

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((initial - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    fill.BorderSizePixel = 0
    fill.Parent = tb
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 3); fc.Parent = fill

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 12, 0, 12)
    thumb.Position = UDim2.new((initial - min) / (max - min), -6, 0.5, -6)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = tb
    local thc = Instance.new("UICorner"); thc.CornerRadius = UDim.new(1, 0); thc.Parent = thumb

    local function setValue(frac)
        local val = math.clamp(min + frac * (max - min), min, max)
        lbl.Text = name .. ": " .. string.format("%.1f", val)
        fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
        thumb.Position = UDim2.new((val - min) / (max - min), -6, 0.5, -6)
        callback(val)
    end

    local dragging = false
    local function update(input)
        local relX = input.Position.X - tb.AbsolutePosition.X
        local frac = math.clamp(relX / tb.AbsoluteSize.X, 0, 1)
        setValue(frac)
    end

    thumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    tb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    table.insert(interactiveAreas, sf)
    return sf
end

