-- ===== FUNÇÃO PRINCIPAL DO SCRIPT =====
local function iniciarScript()
    if scriptIniciado then return end
    scriptIniciado = true

    if not Cam then
        Cam = Workspace.CurrentCamera
    end
    if not Cam then
        repeat
            task.wait(0.1)
            Cam = Workspace.CurrentCamera
        until Cam or scriptIniciado == false
    end
    if not Cam then return end

    FOVring = Drawing.new("Circle")
    FOVring.Visible = true
    FOVring.Thickness = fovThickness
    FOVring.Color = Color3.fromRGB(128, 0, 128)
    FOVring.Filled = false
    FOVring.Radius = fov
    FOVring.Position = Cam.ViewportSize / 2

    local function updateDrawings()
        FOVring.Position = Cam.ViewportSize / 2
        FOVring.Radius = fov
        FOVring.Thickness = fovThickness
    end

    local function isPlayerVisible(player)
        local char = player.Character
        if not char then return false end
        local head = char:FindFirstChild("Head")
        if not head then return false end

        local cameraPos = Cam.CFrame.Position
        local targetPos = head.Position

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = { localChar, char }

        local result = Workspace:Raycast(cameraPos, (targetPos - cameraPos), params)
        return result == nil
    end

    local function lookAt(targetPos)
        local cameraPos = Cam.CFrame.Position
        local lookVector = (targetPos - cameraPos).unit
        local newCFrame = CFrame.new(cameraPos, cameraPos + lookVector)
        Cam.CFrame = newCFrame
    end

    local function getClosestPlayerInFOV(trg_part)
        local nearest = nil
        local last = math.huge
        local mousePos = Cam.ViewportSize / 2

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer then
                local ally = isAlly(player)
                if (ally and not espAliados) or (not ally and not espInimigos) then
                    continue
                end
                local char = player.Character
                if char then
                    local part = char:FindFirstChild(trg_part)
                    if part then
                        local ePos, isOnScreen = Cam:WorldToViewportPoint(part.Position)
                        local distance = (Vector2.new(ePos.x, ePos.y) - mousePos).Magnitude
                        if isOnScreen and distance < fov and distance < last and isPlayerVisible(player) then
                            last = distance
                            nearest = player
                        end
                    end
                end
            end
        end
        return nearest
    end

    local function createESP(player)
        if espObjects[player] then return end
        local data = {
            box = Drawing.new("Square"),
            tracer = Drawing.new("Line"),
            distanceText = Drawing.new("Text")
        }
        data.box.Visible = false
        data.box.Thickness = 1.5
        data.box.Color = Color3.fromRGB(0, 255, 0)
        data.box.Transparency = 1 - boxOpacity
        data.box.Filled = false

        data.tracer.Visible = false
        data.tracer.Thickness = 1.5
        data.tracer.Color = Color3.fromRGB(255, 255, 255)
        data.tracer.Transparency = 1 - tracerOpacity

        data.distanceText.Visible = false
        data.distanceText.Size = 14
        data.distanceText.Center = true
        data.distanceText.Color = Color3.fromRGB(255, 255, 255)
        data.distanceText.Transparency = 0
        data.distanceText.Font = 0

        local ally = isAlly(player)
        local color = ally and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        data.box.Color = color
        data.tracer.Color = color
        data.distanceText.Color = color

        espObjects[player] = data
    end

    local function removeESP(player)
        local data = espObjects[player]
        if data then
            data.box:Remove()
            data.tracer:Remove()
            data.distanceText:Remove()
            espObjects[player] = nil
        end
    end

    local function updateESP()
        if not espAtivo then
            for _, data in pairs(espObjects) do
                data.box.Visible = false
                data.tracer.Visible = false
                data.distanceText.Visible = false
            end
            return
        end

        local viewport = Cam.ViewportSize
        local bottomCenter = Vector2.new(viewport.X / 2, viewport.Y)

        for player, data in pairs(espObjects) do
            local char = player.Character
            if not char or not player.Parent then
                removeESP(player)
                continue
            end

            local ally = isAlly(player)
            if (ally and not espAliados) or (not ally and not espInimigos) then
                data.box.Visible = false
                data.tracer.Visible = false
                data.distanceText.Visible = false
                continue
            end

            local head = char:FindFirstChild("Head")
            local torso = char:FindFirstChild("Torso") 
                       or char:FindFirstChild("UpperTorso") 
                       or char:FindFirstChild("LowerTorso") 
                       or char:FindFirstChild("HumanoidRootPart")

            if head and torso then
                local headPos, headVis = Cam:WorldToViewportPoint(head.Position)
                local torsoPos = Cam:WorldToViewportPoint(torso.Position)

                if headVis then
                    local distance = math.floor((Cam.CFrame.Position - head.Position).Magnitude)
                    local height = math.abs(headPos.Y - torsoPos.Y) * 3.5
                    local width = height * 0.5
                    local centerX = headPos.X
                    local centerY = (headPos.Y + torsoPos.Y) / 2

                    data.box.Visible = boxAtivo
                    if boxAtivo then
                        data.box.Size = Vector2.new(width, height)
                        data.box.Position = Vector2.new(centerX - width/2, centerY - height/2)
                        data.box.Transparency = 1 - boxOpacity
                    end

                    data.tracer.Visible = tracerAtivo
                    if tracerAtivo then
                        data.tracer.From = bottomCenter
                        data.tracer.To = Vector2.new(headPos.X, headPos.Y)
                        data.tracer.Transparency = 1 - tracerOpacity
                    end

                    data.distanceText.Visible = distanciaAtivo
                    if distanciaAtivo then
                        data.distanceText.Text = tostring(distance) .. "m"
                        data.distanceText.Position = Vector2.new(headPos.X, headPos.Y + height/2 + 20)
                    end
                else
                    data.box.Visible = false
                    data.tracer.Visible = false
                    data.distanceText.Visible = false
                end
            else
                data.box.Visible = false
                data.tracer.Visible = false
                data.distanceText.Visible = false
            end
        end
    end

    local function setupPlayer(player)
        if player == localPlayer then return end
        player.CharacterAdded:Connect(function()
            removeESP(player)
            createESP(player)
        end)
        if player.Character then createESP(player) end
    end

    for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
    Players.PlayerAdded:Connect(setupPlayer)
    Players.PlayerRemoving:Connect(removeESP)
    localPlayer.CharacterAdded:Connect(function(char) localChar = char end)

    fullCleanup = function()
        if mainLoopConn then mainLoopConn:Disconnect(); mainLoopConn = nil end
        if FOVring then FOVring:Remove(); FOVring = nil end
        for player, data in pairs(espObjects) do
            data.box:Remove()
            data.tracer:Remove()
            data.distanceText:Remove()
        end
        espObjects = {}
        if menuGui then menuGui:Destroy() end
        if notificationGui then notificationGui:Destroy() end
        pararFly()
        pcall(function()
            local lg = CoreGui:FindFirstChild("JV_Loading")
            if lg then lg:Destroy() end
        end)
        pcall(function()
            for _, e in ipairs(Lighting:GetChildren()) do
                if e:IsA("BlurEffect") and e.Name == "JV_LoadingBlur" then
                    e:Destroy()
                end
            end
        end)
    end

    task.spawn(function()
        while not antiKickReady do task.wait(0.3) end
        showNotification("🟩 Anti Kick ativado com sucesso.", Color3.fromRGB(0, 255, 0), 3)
        task.wait(3.5)
        showNotification("🟩 Menu JV Store carregado.", Color3.fromRGB(0, 255, 0), 2)
        task.wait(2.5)
        showNotification("🟨 Verificando recursos...", Color3.fromRGB(255, 255, 0), 2)
        task.wait(2.5)
        if (FOVring and espObjects and mainLoopConn) then
            showNotification("🟩 Verificação concluída.", Color3.fromRGB(0, 255, 0), 2)
            task.wait(2.5)
            showNotification("🟩 Script iniciado com sucesso.", Color3.fromRGB(0, 255, 0), 2)
        else
            showNotification("🟥 Erro na verificação de recursos.", Color3.fromRGB(255, 0, 0), 3)
        end
    end)

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Delete then
            fullCleanup()
        end
    end)

    mainLoopConn = RunService.RenderStepped:Connect(function()
        updateDrawings()

        local baseTransparency = 1 - fovOpacity
        if aimbotAtivo then
            local closest = getClosestPlayerInFOV("Head")
            if closest and closest.Character and closest.Character:FindFirstChild("Head") then
                if isPlayerVisible(closest) then
                    lookAt(closest.Character.Head.Position)
                end
                local ePos, isVis = Cam:WorldToViewportPoint(closest.Character.Head.Position)
                if isVis then
                    local dist = (Vector2.new(ePos.x, ePos.y) - Cam.ViewportSize / 2).Magnitude
                    FOVring.Transparency = math.clamp(baseTransparency + (1 - (dist / fov)) * maxTransparency, 0, 1)
                else
                    FOVring.Transparency = baseTransparency
                end
            else
                FOVring.Transparency = baseTransparency
            end
        else
            FOVring.Transparency = baseTransparency
        end

        updateESP()
    end)
end

-- ===== FUNÇÕES DE FLY (MELHORADAS COM SUAVIZAÇÃO E RUÍDO) =====
local function iniciarFly()
    if flyConn then return end

    local char = localPlayer.Character
    if not char then
        warn("Fly: personagem não encontrado.")
        return
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        warn("Fly: Humanoid não encontrado.")
        return
    end

    local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not rootPart then
        warn("Fly: raiz não encontrada.")
        return
    end

    -- Desativa estados do Humanoid (para evitar interferência)
    for _, state in ipairs({
        Enum.HumanoidStateType.Climbing,
        Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Flying,
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.GettingUp,
        Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.Landed,
        Enum.HumanoidStateType.Physics,
        Enum.HumanoidStateType.PlatformStanding,
        Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.Running,
        Enum.HumanoidStateType.RunningNoPhysics,
        Enum.HumanoidStateType.Seated,
        Enum.HumanoidStateType.StrafingNoPhysics,
        Enum.HumanoidStateType.Swimming
    }) do
        hum:SetStateEnabled(state, false)
    end

    hum.PlatformStand = true

    -- BodyGyro para controle de rotação
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.P = 9e4
    flyBodyGyro.CFrame = rootPart.CFrame
    flyBodyGyro.Parent = rootPart

    -- BodyVelocity com MaxForce ajustável (proteção)
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVelocity.Velocity = Vector3.new(0, 0.1, 0)
    flyBodyVelocity.Parent = rootPart

    -- Conecta teclas (armazenando conexões para limpeza)
    flyKeys = {}
    local keyConn1 = UserInputService.InputBegan:Connect(function(input)
        if flyAtivo and input.UserInputType == Enum.UserInputType.Keyboard then
            flyKeys[input.KeyCode] = true
        end
    end)
    local keyConn2 = UserInputService.InputEnded:Connect(function(input)
        if flyAtivo and input.UserInputType == Enum.UserInputType.Keyboard then
            flyKeys[input.KeyCode] = nil
        end
    end)
    flyKeyConns = {keyConn1, keyConn2}

    -- Loop principal com suavização e ruído (anti-detecção)
    flyConn = RunService.Heartbeat:Connect(function()
        if not flyAtivo then return end

        local char = localPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not root then return end

        local cameraCFrame = Cam.CFrame
        local moveDirection = Vector3.new(0, 0, 0)

        if flyKeys[Enum.KeyCode.W] then moveDirection += cameraCFrame.LookVector end
        if flyKeys[Enum.KeyCode.S] then moveDirection -= cameraCFrame.LookVector end
        if flyKeys[Enum.KeyCode.A] then moveDirection -= cameraCFrame.RightVector end
        if flyKeys[Enum.KeyCode.D] then moveDirection += cameraCFrame.RightVector end

        if flyUpHeld then moveDirection += Vector3.new(0, 1, 0) end
        if flyDownHeld then moveDirection -= Vector3.new(0, 1, 0) end

        local targetVelocity = Vector3.new(0, 0, 0)
        if moveDirection.Magnitude > 0 then
            targetVelocity = moveDirection.Unit * flySpeed
        end

        -- Suavização para evitar picos bruscos
        local smoothFactor = 0.15
        flySmoothVelocity = flySmoothVelocity:Lerp(targetVelocity, smoothFactor)

        -- Adiciona um pequeno ruído aleatório (dificulta detecção)
        local noise = Vector3.new(
            (math.random() - 0.5) * 0.2,
            (math.random() - 0.5) * 0.2,
            (math.random() - 0.5) * 0.2
        )
        flySmoothVelocity += noise

        flyBodyVelocity.Velocity = flySmoothVelocity
        flyBodyGyro.CFrame = cameraCFrame
    end)
end

local function pararFly()
    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end
    for _, conn in ipairs(flyKeyConns) do
        conn:Disconnect()
    end
    flyKeyConns = {}
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end
    flySmoothVelocity = Vector3.new(0,0,0)

    local char = localPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            -- Reativa os estados
            for _, state in ipairs({
                Enum.HumanoidStateType.Climbing,
                Enum.HumanoidStateType.FallingDown,
                Enum.HumanoidStateType.Flying,
                Enum.HumanoidStateType.Freefall,
                Enum.HumanoidStateType.GettingUp,
                Enum.HumanoidStateType.Jumping,
                Enum.HumanoidStateType.Landed,
                Enum.HumanoidStateType.Physics,
                Enum.HumanoidStateType.PlatformStanding,
                Enum.HumanoidStateType.Ragdoll,
                Enum.HumanoidStateType.Running,
                Enum.HumanoidStateType.RunningNoPhysics,
                Enum.HumanoidStateType.Seated,
                Enum.HumanoidStateType.StrafingNoPhysics,
                Enum.HumanoidStateType.Swimming
            }) do
                hum:SetStateEnabled(state, true)
            end
        end
    end

    flyKeys = {}
    flyUpHeld = false
    flyDownHeld = false
end

